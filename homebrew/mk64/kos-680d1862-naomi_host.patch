diff --git a/kernel/arch/dreamcast/hardware/g2bus.c b/kernel/arch/dreamcast/hardware/g2bus.c
index 0b1bdf44..2f298863 100644
--- a/kernel/arch/dreamcast/hardware/g2bus.c
+++ b/kernel/arch/dreamcast/hardware/g2bus.c
@@ -188,6 +188,27 @@ void g2_memset_8(uintptr_t address, uint8_t c, size_t amt) {
 
 /* When writing to the SPU RAM, this is required at least every 8 32-bit
    writes that you execute */
+#ifdef NAOMI_HOST
+/* dc2naomi: on a NAOMI the SB_FFST bits (0xa05f688c bit 0 AICA, bit 4 G2) do not
+   clear the way they do on a Dreamcast, and these waits never end - dc2naomi has
+   to patch the same spin out of several commercial games (G2CHK0 and G2CHK4 in its
+   games.py, which give up after 3000000 turns and carry on as if the FIFO were
+   empty). Same count here, then give up; once the bits are known to stick, stop
+   paying for the long wait, because this is called every few writes to SPU RAM.
+   g2_fifo_stuck counts the give-ups: 0 means the FIFO behaved all run. */
+unsigned g2_fifo_stuck = 0;
+unsigned g2_fifo_cap = 3000000u;
+
+void g2_fifo_wait(void) {
+    for(unsigned n = g2_fifo_cap; n; n--)
+        if(!(FIFO_STATUS & (FIFO_AICA | FIFO_G2)))
+            return;
+
+    g2_fifo_stuck++;
+    g2_fifo_cap = 1024u;
+}
+#else
 void g2_fifo_wait(void) {
     while(FIFO_STATUS & (FIFO_AICA | FIFO_G2));
 }
+#endif
