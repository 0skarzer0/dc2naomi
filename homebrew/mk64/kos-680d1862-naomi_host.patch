+#ifdef NAOMI_HOST
+/* dc2naomi live debugging: answer the NetDIMM's peek/poke requests (netboot tools, TCP 10703;
+   dc2naomi's tools/board/pk.py) from here, every vblank, before the resident's maple hook.
+   Same protocol and address rules as the resident's dimm_service() (resident.c, after
+   libnaomi's dimmcomms.c by DragonMinded): command word bit 15 = pending, bits 14-9 = id
+   (4/5/6 peek 8/16/32, 8/9/10 poke 8/16/32), bits 8-0 + OFFSETL = a 25-bit offset into the
+   32 MB of RAM, unless a 32-bit poke at offset 0x01fffffc set a window base (0xa0000000 for
+   Holly/AICA/VRAM, 0xff000000 for SH4 registers, 0 = RAM again).
+   naomi_live records what this program is doing, so a hung game can still be read:
+   the PC/PR the vblank interrupted, and the main thread's saved PC/PR. */
+#define NP_CMD    (*(volatile uint16 *)0xa05f703c)
+#define NP_OFFL   (*(volatile uint16 *)0xa05f7040)
+#define NP_PARL   (*(volatile uint16 *)0xa05f7044)
+#define NP_PARH   (*(volatile uint16 *)0xa05f7048)
+#define NP_STAT   (*(volatile uint16 *)0xa05f704c)
+#define NP_ISTEXT (*(volatile uint32 *)0xa05f6904)
+#define NP_WINDOW 0x01fffffcu
+
+typedef struct {
+    uint32 magic;            /* "LIVE" */
+    uint32 vbls;             /* calls from the vblank (maple) path */
+    uint32 served;           /* peek/poke requests answered here */
+    uint32 last_cmd;         /* last command word seen with bit 15 set */
+    uint32 istext;           /* ISTEXT at the last call */
+    uint32 irq_pc, irq_pr, irq_sr;   /* what the vblank interrupted */
+    uint32 main_pc, main_pr;         /* thread 1's saved context (when not running) */
+    uint32 pc_ring[16];      /* irq_pc of the last 16 vblanks */
+    uint32 thd_polls;        /* turns of the peek thread */
+    uint32 halted;           /* 1 = arch_abort/exit/reboot reached: stopped here instead of resetting */
+    uint32 halt_pr;          /* who called it */
+    uint32 halt_why;         /* 1 abort, 2 exit, 3 reboot */
+    uint32 log_pos;          /* bytes written to log[] so far (it wraps) */
+    uint32 exc_code, exc_evt, exc_pc, exc_pr, exc_sr;   /* the unhandled IRQ/exception (irq.c) */
+    uint32 exc_r[16];
+    uint32 exc_expevt, exc_intevt, exc_tea;            /* SH4 EXPEVT, INTEVT, TEA at that moment */
+    char log[8192];          /* everything KallistiOS printed (dbgio + dcload console), even disabled */
+} naomi_live_t;
+naomi_live_t naomi_live = { 0x4556494cu };
+static uint32 np_base;
+
+static uint32 np_addr(uint32 a) {
+    uint32 phys = a & 0x1fffffffu;
+    if(a >= 0xff000000u) return a;
+    if(phys >= 0x0c000000u && phys < 0x0e000000u)
+        return ((a >> 29) == 5 ? 0xa0000000u : 0x80000000u) | phys;
+    if((phys >= 0x005f6800u && phys < 0x005fa000u) || (phys >= 0x00700000u && phys < 0x00711000u) ||
+       (phys >= 0x00800000u && phys < 0x00a00000u) || (phys >= 0x04000000u && phys < 0x05800000u))
+        return 0xa0000000u | phys;
+    return 0;
+}
+
+void naomi_peek_poll(void) {
+    naomi_live.istext = NP_ISTEXT;
+    if(!(naomi_live.istext & 8)) return;
+    uint32 cmd = NP_CMD;
+    if(cmd == 0xffff || !(cmd & 0x8000)) return;
+    naomi_live.last_cmd = cmd;
+
+    uint32 id = (cmd >> 9) & 0x3f, ret = 1, pl = 0, ph = 0;
+    uint32 off = ((cmd & 0x1ff) << 16) | NP_OFFL;
+    uint32 a = off + (np_base ? np_base : 0x0c000000u);
+    uint32 val = (uint32)NP_PARH << 16 | NP_PARL;
+    uint32 t = np_addr(a);
+    if(off == NP_WINDOW && id == 10) { np_base = val; id = 0; }
+    if(off == NP_WINDOW && id == 6) { pl = np_base & 0xffff; ph = np_base >> 16; id = 0; }
+    switch(id) {
+        case 0: case 1: break;
+        case 3: np_base = val; break;
+        case 4: pl = t ? *(volatile uint8 *)t : 0xad; break;
+        case 5: if(a & 1) ret = 0; else pl = t ? *(volatile uint16 *)t : 0xbadd; break;
+        case 6:
+            if(a & 3) { ret = 0; break; }
+            { uint32 v = t ? *(volatile uint32 *)t : 0xbadadd00u; pl = v & 0xffff; ph = v >> 16; }
+            break;
+        case 8: if(t) *(volatile uint8 *)t = (uint8)val; break;
+        case 9: if(a & 1) ret = 0; else if(t) *(volatile uint16 *)t = (uint16)val; break;
+        case 10: if(a & 3) ret = 0; else if(t) *(volatile uint32 *)t = val; break;
+        default: ret = 0xff; break;
+    }
+    NP_CMD = (uint16)((cmd & 0x7e00) | ret);
+    NP_OFFL = 0;
+    NP_PARL = (uint16)pl;
+    NP_PARH = (uint16)ph;
+    NP_STAT = (uint16)(NP_STAT | 0x100);                       /* acknowledge its interrupt */
+    for(uint32 i = 0; i < 200000 && (NP_ISTEXT & 8); i++) {}
+    NP_STAT = (uint16)(NP_STAT & 0xfffe);                      /* answer ready */
+    naomi_live.served++;
+}
+
+void naomi_record_exc(int code, uint32 evt, const irq_context_t *c) {
+    naomi_live.exc_code = (uint32)code; naomi_live.exc_evt = evt;
+    naomi_live.exc_expevt = *(volatile uint32 *)0xff000024;
+    naomi_live.exc_intevt = *(volatile uint32 *)0xff000028;
+    naomi_live.exc_tea = *(volatile uint32 *)0xff00000c;
+    if(c) {
+        naomi_live.exc_pc = c->pc; naomi_live.exc_pr = c->pr; naomi_live.exc_sr = c->sr;
+        for(int i = 0; i < 16; i++) naomi_live.exc_r[i] = c->r[i];
+    }
+}
+
+void naomi_log_put(const void *data, int len) {
+    const char *c = (const char *)data;
+    for(int i = 0; i < len; i++)
+        naomi_live.log[naomi_live.log_pos++ & 8191] = c[i];
+}
+
+/* Instead of resetting the board (which sends it back to the BIOS and the NetDIMM loads the image
+   again, in a loop, with nothing left to read), stop here and keep answering peeks: naomi_live.log
+   then holds the panic message and the register dump of the exception. */
+__attribute__((noreturn)) void naomi_halt(uint32 why, uint32 pr) {
+    naomi_live.halted = 1;
+    naomi_live.halt_why = why;
+    naomi_live.halt_pr = pr;
+    irq_disable();
+    for(;;)
+        naomi_peek_poll();
+}
+
+/* Called every vblank from the maple path: sample what the vblank interrupted. */
+static void naomi_live_tick(void) {
+    irq_context_t *c = irq_get_context();
+    kthread_t *m = thd_by_tid(1);
+    naomi_live.vbls++;
+    if(c) {
+        naomi_live.irq_pc = c->pc; naomi_live.irq_pr = c->pr; naomi_live.irq_sr = c->sr;
+        naomi_live.pc_ring[naomi_live.vbls & 15] = c->pc;
+    }
+    if(m && m != thd_current) { naomi_live.main_pc = m->context.pc; naomi_live.main_pr = m->context.pr; }
+    naomi_peek_poll();
+}
+
+/* A thread of its own that answers the NetDIMM every 2 ms, as the Daytona native NAOMI port does
+   (naomi_dimmcomms.c, proven on the board): the maple path above only runs while the program keeps
+   starting maple transfers, and a hung program may not. Started by KOS init (init.c) before main(). */
+static void *naomi_live_thd(void *arg) {
+    (void)arg;
+    for(;;) {
+        int o = irq_disable();
+        naomi_live.thd_polls++;
+        naomi_peek_poll();
+        irq_restore(o);
+        thd_sleep(2);
+    }
+    return NULL;
+}
+
+void naomi_live_start(void) {
+    const kthread_attr_t attr = { .create_detached = true, .stack_size = 4096, .label = "naomi live" };
+    if(!thd_create_ex(&attr, naomi_live_thd, NULL))
+        dbglog(DBG_ERROR, "naomi live: no peek thread\n");
+}
+#endif
+
 /* Set the DMA Address */
 void maple_dma_addr(void *ptr) {
+#ifdef NAOMI_HOST
+    naomi_live_tick();
+    /* dc2naomi: on a NAOMI there is no maple bus. The resident translates the frame
+       list, answering with the cabinet's JVS controls as a Dreamcast controller (and
+       the emulated Visual Memory), and gives back the address to hand the hardware.
+       It publishes its entry points in a table at RES_BASE, 0x8dc00000:
+         +0 magic "DCLR"  +4 boot_entry  +8 maple_hook  +12/+16 bss
+       (resident/head.S and resident.h in https://github.com/0skarzer0/dc2naomi).
+       Reading the hook from that table instead of patching this function's literal
+       keeps working when the resident is rebuilt, and falls through to the normal
+       path when the table is not there, i.e. on a real Dreamcast. */
+    const volatile uint32 *rt = (const volatile uint32 *)0x8dc00000;
+    if(rt[0] == 0x524c4344u && rt[2]) {
+        uint32 (*hook)(uint32) = (uint32 (*)(uint32))rt[2];
+        maple_write(MAPLE_DMAADDR, hook((uint32)ptr));
+        return;
+    }
+#endif
     maple_write(MAPLE_DMAADDR, ((uint32) ptr) & MEM_AREA_CACHE_MASK);
 }
 
