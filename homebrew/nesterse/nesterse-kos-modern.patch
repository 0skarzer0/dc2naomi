@@ -178,6 +179,69 @@ int Image_Load_JPG(Image* img, const char* filename, pvr_list_t list, int filter
 	
 	return 1;
 }
+
+/* (modern KallistiOS) kos-ports' libimageload still calls libpng's readpng_* with their old signatures
+   (readpng_get_image without the state pointer: png_error jumps to garbage), so PNGs are read here with
+   libpng's current readpng_* and turned into the texture formats imageload gave: RGB565 (IMG_ALPHA_NONE),
+   ARGB1555 with the colour key (IMG_ALPHA_KEYED) or the alpha channel (IMG_ALPHA_MASK), ARGB4444 (IMG_ALPHA_FULL). */
+/* imageload.h (included above) declares the old signatures, so the current ones get other C names */
+extern void *nse_readpng_init(FILE *infile) __asm__("_readpng_init");
+extern uint8_t *nse_readpng_get_image(void *strs, uint32_t *pChannels, uint32_t *pRowbytes, uint32_t *pWidth,
+	uint32_t *pHeight) __asm__("_readpng_get_image");
+extern void nse_readpng_cleanup(void *strs) __asm__("_readpng_cleanup");
+static int nse_load_png(const char *filename, IMG_ALPHA alpha, uint32 key, kos_img_t *out)
+{
+	uint32_t ch, rb, w, h, x, yy;
+	uint8_t *buf;
+	uint16 *t;
+	void *strs;
+	FILE *f = fopen(filename, "rb");
+	if (!f)
+		return -1;
+	strs = nse_readpng_init(f);
+	if (!strs) { fclose(f); return -1; }
+	buf = nse_readpng_get_image(strs, &ch, &rb, &w, &h);
+	nse_readpng_cleanup(strs);
+	fclose(f);
+	if (!buf)
+		return -1;
+	t = (uint16 *) malloc(w * h * 2);
+	if (!t) { free(buf); return -1; }
+	for (yy = 0; yy < h; yy++)
+		for (x = 0; x < w; x++)
+		{
+			const uint8_t *q = buf + yy * rb + x * ch;
+			uint32 r = q[0], g = q[1], b = q[2], a = ch >= 4 ? q[3] : 255;
+			uint16 v;
+			switch (alpha)
+			{
+				case IMG_ALPHA_KEYED:
+					/* the key at ARGB1555 precision (the art has 252,2,252 as well as 255,0,255) or a
+					   transparent palette entry (tRNS) */
+					v = (a < 128 || ((((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3)) ==
+						((((key >> 16) & 0xff) >> 3) << 10 | (((key >> 8) & 0xff) >> 3) << 5 | ((key & 0xff) >> 3)))) ? 0 :
+						(0x8000 | ((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3));
+					break;
+				case IMG_ALPHA_MASK:
+					v = (a >= 128 ? 0x8000 : 0) | ((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3);
+					break;
+				case IMG_ALPHA_FULL:
+					v = ((a >> 4) << 12) | ((r >> 4) << 8) | ((g >> 4) << 4) | (b >> 4);
+					break;
+				default:
+					v = ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3);
+					break;
+			}
+			t[yy * w + x] = v;
+		}
+	free(buf);
+	out->data = t;
+	out->w = w;
+	out->h = h;
+	out->byte_count = w * h * 2;
+	out->fmt = 0;
+	return 0;
+}
 
 int Image_Load(Image* img, const char* filename, pvr_list_t list, int filtering, IMG_ALPHA alpha)
 {
@@ -197,7 +261,10 @@ int Image_Load(Image* img, const char* filename, pvr_list_t list, int filtering,
 	info.key = 0x00ff00ff;
 	kos_img_t kimg;
 	kimg.data = NULL;
-	img_load_file(filename, &info, &kimg);
+	if (stricmp(filename + (strlen(filename)-4), ".png") == 0)
+		nse_load_png(filename, alpha, info.key, &kimg);
+	else
+		img_load_file(filename, &info, &kimg);
 	if (!kimg.data)
 		return 0;
 	
