+#ifdef GD_TROZO
+        /* NAOMI (dc2naomi, 2026-11): el residente sirve cada lectura de una vez, copiando de la NetDIMM con las
+           interrupciones cortadas (~1,3 MB/s): una lectura de 64 sectores paraba el juego ~90 ms (los tirones de la
+           carrera mientras se lee la etapa siguiente, y uno cada vez que la musica pide su trozo). Aqui se pide de
+           GD_TROZO en GD_TROZO sectores y se cede la CPU entre trozo y trozo: el bucle entra entre medias. */
+        {
+            int h = 0, m;
+            r = 0;
+            while (h < n && !r) {
+                m = n - h > GD_TROZO ? GD_TROZO : n - h;
+                r = cdrom_read_sectors_ex((uint8_t *)dst + h * 2048, lba + h + 150, m, ((uintptr_t)dst & 31) == 0);
+                h += m;
+                if (h < n) thd_pass();
+            }
+            if (!r) break;
+        }
+#else
         if (!(r = cdrom_read_sectors_ex(dst, lba + 150, n, ((uintptr_t)dst & 31) == 0))) break;
+#endif
         n_err++; ult_err = r;
         if (r == ERR_DISC_CHG || r == ERR_NO_DISC) cdrom_reinit();
         thd_sleep(20);
