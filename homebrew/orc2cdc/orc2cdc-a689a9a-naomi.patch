+     v = elevacion de -20 (0) a +70 grados (1)), cargada en la VRAM al arrancar (ref_pano_carga), o
+   - si no hay panoramica de esa zona, el cielo de la etapa que se dibuja (la mayor textura de la lista 3, grupo 0, por
+     encima del horizonte: u alrededor, unas REF_REP_CIELO vueltas, v = 0 en el horizonte .. 1 en el cenit).
+   UV por vertice (las cuentas de coche_entorno y una mas): u = rumbo de la camara + la direccion de la normal (la que
+   mira a la derecha de la pantalla coge lo de la derecha, la de atras lo de detras) + REF_KZ x la posicion a lo largo
+   del coche + la distancia recorrida x REF_KZ x REF_VEL: lo reflejado gira con las curvas y corre hacia atras por la
+   carroceria al avanzar (el truco del original que describio el usuario); v = REF_V0 + REF_VUP x la normal hacia
+   arriba (el capo coge lo alto; los costados, el horizonte). La fuerza: el color base del vertice (textura x base +
+   pintura), REF_K0 + REF_K1 x lo que mira arriba, puesto al entrar (y el de antes, de vuelta al salir).
+   0: el mapa del coche siempre (lo de antes) */
+#ifndef REFLEJO_CIELO
+#define REFLEJO_CIELO 0
+#endif
+#ifndef REF_REP_CIELO
+#define REF_REP_CIELO 4.0f
+#endif
+#ifndef REF_KZ
+#define REF_KZ 0.03f                                            /* vueltas por metro a lo largo del coche */
+#endif
+#ifndef REF_VEL
+#define REF_VEL 0.1f                                            /* 1: a la velocidad de un espejo de verdad */
+#endif
+#ifndef REF_K0
+#define REF_K0 0.08f                                            /* (0,15 / 0,30: el rojo salia rosa; usuario, 2026-11-18) */
+#endif
+#ifndef REF_K1
+#define REF_K1 0.28f
+#endif
+#define REF_NPANO 40
+typedef struct { char zona[4]; pvr_ptr_t v; } ref_pano_t;
+static ref_pano_t ref_pano[REF_NPANO]; static int ref_np; static uint32_t ref_pw, ref_ph;
+/* REFLEJO.DAT ('REF1', n, ancho, alto; n x {zona, desplazamiento, tamano, formato 0x101}; VQ RGB565 de 256 entradas) */
+static void ref_pano_carga(void)
+{
+    uint32_t sz, n, k, h[4]; uint8_t *e = gd_carga("REFLEJO.DAT", &sz);
+    if (!e) return;
+    if (sz >= 16 && !memcmp(e, "REF1", 4)) {
+        memcpy(&n, e + 4, 4); memcpy(&ref_pw, e + 8, 4); memcpy(&ref_ph, e + 12, 4);
+        for (k = 0; k < n && ref_np < REF_NPANO && 16 + 16 * k + 16 <= sz; k++) {
+            pvr_ptr_t v;
+            memcpy(h, e + 16 + 16 * k, 16);
+            if (h[3] != 0x101 || h[1] + h[2] > sz || h[2] != 2048 + ref_pw * ref_ph / 4 || !(v = pvr_mem_malloc(h[2]))) break;
+            pvr_txr_load(e + h[1], v, h[2]);
+            memcpy(ref_pano[ref_np].zona, &h[0], 4); ref_pano[ref_np].v = v; ref_np++;
+        }
+    }
+    dbglog(DBG_INFO, "REFLEJO: %d panoramicas de %ux%u\n", ref_np, (unsigned)ref_pw, (unsigned)ref_ph);
+    free(e);
+}
+static int ref_cielo_tex(const modelo_t *mo)                    /* la textura del cielo de mo (o -1) */
+{
+    uint32_t k, area = 0; int mejor = -1;
+    if (!mo || !mo->tv) return -1;
+    for (k = mo->inicio[3]; k < mo->inicio[4]; k++) {
+        const malla_t *m = mo->mallas + k; const tex_t *t; const vert_t *vv; uint32_t q;
+        if (m->nodo < -256 || m->tex < 0 || (uint32_t)m->tex >= mo->ntex || m->n < 3) continue;   /* (grupo 0) */
+        if (!mo->tv[m->tex] || mo->tv[m->tex] == tex_gris) continue;
+        t = mo->texs + m->tex; if ((t->fmt & 0xff) > 2 || t->w * t->h <= area) continue;
+        vv = mo->verts + m->v0; for (q = 0; q < m->n && vv[q].y <= 0.0f; q++) ;
+        if (q == m->n) continue;                                /* (todo por debajo del horizonte: el mar lejano) */
+        area = t->w * t->h; mejor = m->tex;
+    }
+    return mejor;
+}
+/* la cabecera de la carroceria (textura t del coche: su lista y estado) con otra textura (formato de 16 bits fb,
+   VQ o no, w x h, en dir: la direccion que va en la cabecera) */
+static void ref_cab(uint32_t t, uint32_t fb, int vq, uint32_t w, uint32_t h, pvr_ptr_t dir)
+{
+    const tex_t *tl = coche.texs + t; uint32_t f;
+    for (f = 0; f < 2; f++) {
+        pvr_poly_cxt_t cx;
+        pvr_poly_cxt_txr(&cx, LISTA[tl->lista], FMT[fb] | PVR_TXRFMT_TWIDDLED | (vq ? PVR_TXRFMT_VQ_ENABLE : 0), w, h, dir,
+                         PVR_FILTER_BILINEAR);
+        cx.gen.fog_type = f ? PVR_FOG_DISABLE : PVR_FOG_TABLE; cx.gen.culling = PVR_CULLING_NONE;
+        cx.txr.env = PVR_TXRENV_MODULATE; cx.gen.specular = PVR_SPECULAR_ENABLE;
+        if (tl->fmt & 0x800) { cx.depth.comparison = PVR_DEPTHCMP_GEQUAL; if (tl->lista == 2) cx.txr.env = PVR_TXRENV_MODULATEALPHA; }
+        if ((tl->fmt & 0x400) && tl->lista == 2) { cx.blend.src = PVR_BLEND_SRCALPHA; cx.blend.dst = PVR_BLEND_ONE; }
+        cx.txr.uv_clamp = PVR_UVCLAMP_V;                        /* (u da la vuelta; v no pasa de abajo ni del cenit) */
+        pvr_poly_compile(&coche.cabs[f][t], &cx);
+    }
+}
+/* base de los vertices de la carroceria: con el reflejo, la fuerza (gris, el alfa de siempre); sin el, la guardada */
+static void ref_base(int on)
+{
+    uint32_t k, i, j = 0;
+    if (on && !ref_c0) {
+        for (k = 0; k < cex_n; k++) if (REF_MALLA(cex_m + k)) ref_nc += cex_n0[cex_m[k].malla];
+        if (!(ref_c0 = malloc(ref_nc * sizeof(uint32_t) + 4))) { ref_nc = 0; return; }
+        for (k = 0; k < cex_n; k++) if (REF_MALLA(cex_m + k)) {
+            const malla_t *m = coche.mallas + cex_m[k].malla;
+            for (i = 0; i < cex_n0[cex_m[k].malla]; i++) ref_c0[j++] = coche.verts[m->v0 + i].c;
+        }
+        j = 0;
+    }
+    if (!ref_c0) return;
+    for (k = 0; k < cex_n; k++) if (REF_MALLA(cex_m + k)) {
+        const malla_t *m = coche.mallas + cex_m[k].malla; const uint32_t *q = cex_vd + cex_m[k].v0;
+        for (i = 0; i < cex_n0[cex_m[k].malla]; i++, j++) {
+            uint32_t c = ref_c0[j];
+            if (on) {                                           /* (las normales del fichero miran hacia dentro) */
+                float up = -(float)(int8_t)(q[i] >> 8) * (1.0f / 127.0f), g = REF_K0 + REF_K1 * (up > 0 ? up : 0);
+                uint32_t gi = (uint32_t)(g * 255.0f); if (gi > 255) gi = 255;
+                c = (c & 0xFF000000u) | gi << 16 | gi << 8 | gi;
+            }
+            coche.verts[m->v0 + i].c = c;
+        }
+    }
+}
+/* cada cuadro, antes de coche_entorno: 1 si la carroceria va con el escenario (y sus UV ya puestas) */
+static int coche_reflejo(matrix_t mc, int en_carrera)
+{
+    float ac[3], bc[3], A[NPZ][3], B[NPZ][3], u0, rep, v0, vup, rumbo, dr, kz, su, *a, *b; uint32_t k, i; int j, p, on, ti = -1;
+    const ref_pano_t *pz = NULL; uintptr_t clave;
+    on = REFLEJO_CIELO && en_carrera && cur_nodo >= 0;
+    if (on) for (j = 0; j < ref_np; j++) if (!memcmp(ref_pano[j].zona, curso[cur_nodo].zona, 4)) { pz = ref_pano + j; break; }
+    if (on && !pz && (!cielo || (ti = ref_cielo_tex(cielo)) < 0)) on = 0;
+    if (!on) {
+        if (ref_on) { ref_on = 0; ref_base(0); coche_cab_cex(); }
+        ref_pos_ok = 0;
+        return 0;
+    }
+    clave = pz ? (uintptr_t)pz->v : (uintptr_t)cielo->tv[ti] | 1;
+    if (!ref_on || ref_clave != clave) {
+        for (k = 0; k < cex_n; k++) {
+            uint32_t t = (uint32_t)coche.mallas[cex_m[k].malla].tex;
+            if (!REF_MALLA(cex_m + k)) continue;
+            if (pz) ref_cab(t, 1, 1, ref_pw, ref_ph, pz->v);
+            else {
+                const tex_t *tc = cielo->texs + ti; uint32_t vq = tc->fmt & 0x100, n = ((tc->fmt >> 16) & 0xff) + 1;
+                ref_cab(t, tc->fmt & 0xff, vq != 0, tc->w, tc->h, vq ? (pvr_ptr_t)((uintptr_t)cielo->tv[ti] - (2048 - 8 * n)) : cielo->tv[ti]);
+            }
+        }
+        if (!ref_on) ref_base(1);
+        ref_on = 1; ref_clave = clave;
+    }
+    if (pz) { rep = 1.0f; v0 = 0.28f; vup = 0.6f; }               /* (+5 grados; arriba, +59) */
+    else { rep = REF_REP_CIELO; v0 = 0.12f; vup = 0.5f; }
+    {   /* distancia recorrida (la posicion del coche; los saltos de mas de 5 m, al recentrar la etapa, no cuentan) */
+        float d0 = mc[3][0] - ref_pos[0], d1 = mc[3][1] - ref_pos[1], d2 = mc[3][2] - ref_pos[2], dd = d0 * d0 + d1 * d1 + d2 * d2;
+        if (ref_pos_ok && dd < 25.0f) ref_dist += sqrtf(dd);
+        ref_pos[0] = mc[3][0]; ref_pos[1] = mc[3][1]; ref_pos[2] = mc[3][2]; ref_pos_ok = 1;
+        if (ref_dist > 1e6f) ref_dist = 0;
+    }
+    rumbo = atan2f(ade[0], ade[2]); dr = atan2f(der[0], der[2]) - rumbo;
+    if (dr > 3.14159265f) dr -= 6.28318531f;
+    else if (dr < -3.14159265f) dr += 6.28318531f;
+    u0 = rumbo * (rep / 6.28318531f);
+    kz = REF_KZ * rep * ((mc[2][0] * ade[0] + mc[2][1] * ade[1] + mc[2][2] * ade[2]) >= 0 ? 1.0f : -1.0f);
+    su = ref_dist * REF_KZ * REF_VEL * rep; su -= floorf(su);
+    u0 += su; u0 -= floorf(u0);
+    for (j = 0; j < 3; j++) {                                   /* (normal hacia dentro: todo por -1) */
+        float nd = mc[j][0] * der[0] + mc[j][1] * der[1] + mc[j][2] * der[2], na = mc[j][0] * ade[0] + mc[j][1] * ade[1] + mc[j][2] * ade[2];
+        ac[j] = (nd * dr * (rep / 6.28318531f) - na * 0.5f * rep) * (-1.0f / 127.0f);   /* derecha: su lado; atras: media vuelta */
+        bc[j] = mc[j][1] * (-vup / 127.0f);
+    }
+    for (p = 0; p < NPZ; p++)
+        for (j = 0; j < 3; j++) {
+            const float *r = ani.ok ? ani_m[p][j] : (const float[3]){ j == 0, j == 1, j == 2 };
+            A[p][j] = r[0] * ac[0] + r[1] * ac[1] + r[2] * ac[2]; B[p][j] = r[0] * bc[0] + r[1] * bc[1] + r[2] * bc[2];
+        }
+    for (k = 0; k < cex_n; k++) {
+        const cex_t *e = cex_m + k; const malla_t *m = coche.mallas + e->malla; vert_t *v = coche.verts + m->v0;
+        const uint32_t *q = cex_vd + e->v0; float a0, a1, a2, b0, b1, b2; uint32_t nv = m->n;
+        if (!REF_MALLA(e)) continue;
+        p = m->nodo < 0 ? 0 : (m->nodo >> 8) & 0xFF; if (p >= NPZ) p = 0;
+        a = A[p]; b = B[p]; a0 = a[0]; a1 = a[1]; a2 = a[2]; b0 = b[0]; b1 = b[1]; b2 = b[2];
+        for (i = 0; i < nv; i++) {
+            uint32_t w = q[i]; float x = (int8_t)w, y = (int8_t)(w >> 8), z = (int8_t)(w >> 16);
+            v[i].u = u0 + x * a0 + y * a1 + z * a2 + kz * v[i].z;
+            v[i].v = v0 + x * b0 + y * b1 + z * b2;
+        }
+    }
+    return 1;
+}
+
+/* Sombras de la calzada sobre el coche (DESVIACION pedida por el usuario, 2026-11-18, NAOMI). En las etapas las sombras
+   de las palmeras, carteles, puentes y vallas son mallas planas aparte de la lista transparente con una textura oscura
+   con alfa (BEAC, SEG17: la 37, 128x128, la sombra de una palmera; 6, 15 y 16, bandas). El coche no se oscurecia al
+   pasar por encima. Ahora, en carrera: de cada tramo subido (etapa, union, siguiente) se apuntan una vez sus mallas de
+   sombra (lista 2, planas: menos de SOM_PLANO m de alto, y con la textura oscura: luminancia media de 9 texeles <
+   SOM_LUM, del blob en la RAM con texel_de); cada cuadro se miran SOM_N puntos a lo largo del coche (su eje z, de
+   punta a punta) sobre esas mallas (esfera de la malla y luego sus triangulos en x, z, con la UV interpolada y el
+   texel: alfa x lo oscuro); y la pintura (desplazamiento de la carroceria con el reflejo, coche_reflejo) y la fuerza
+   del reflejo se multiplican por 1 - SOM_K x la sombra interpolada a lo largo del coche: la sombra lo recorre de la
+   punta a la cola al pasar. Solo se reescriben los vertices cuando cambia la sombra (en 16 niveles): fuera de las
+   sombras no cuesta nada. La forma de la sombra (las hojas) no se ve en la carroceria: es un degradado a lo largo */
+#ifndef SOM_K
+#define SOM_K 0.55f
+#endif
+#define SOM_N 6
+#define SOM_PLANO 0.8f
+#define SOM_LUM 90
+typedef struct { const uint8_t *datos; uint16_t *ml; uint32_t n; } som_mod_t;
+static som_mod_t som_m[3];
+static uint8_t som_q[SOM_N], som_aplicada;                     /* sombra de cada punto (0..15) puesta en los vertices */
+static float som_z0, som_z1; static int som_z_ok;
+/* ARGB (0..255 cada uno) del texel (u, v) de la textura i de mo (del blob; la textura como venia) */
+static uint32_t som_texel(const modelo_t *mo, int i, float u, float v)
+{
+    static const uint8_t CAN[3][4][2] = { { { 15, 1 }, { 10, 5 }, { 5, 5 }, { 0, 5 } }, { { 0, 0 }, { 11, 5 }, { 5, 6 }, { 0, 5 } },
+                                          { { 12, 4 }, { 8, 4 }, { 4, 4 }, { 0, 4 } } };
+    const tex_t *t = (mo->tex0 ? mo->tex0 : mo->texs) + i; uint32_t fb = t->fmt & 0xff, w = t->w, h = t->h, sd, x, y, k, r = 0, c;
+    uint16_t tx;
+    if (fb > 2 || w < 8 || h < 8) return 0;
+    sd = w < h ? w : h;
+    u -= floorf(u); v -= floorf(v);
+    x = (uint32_t)(u * w) & (w - 1); y = (uint32_t)(v * h) & (h - 1);
+    k = (w > h ? x / sd : y / sd) * sd * sd + (tw_bits(y % sd) | tw_bits(x % sd) << 1);
+    tx = texel_de(mo, t, k);
+    for (c = 0; c < 4; c++) {
+        uint32_t mx = (1u << CAN[fb][c][1]) - 1, val = CAN[fb][c][1] ? ((tx >> CAN[fb][c][0]) & mx) * 255 / mx : 255;
+        r |= val << (24 - 8 * c);
+    }
+    return r;
+}
+/* las mallas de sombra de mo (una vez por fichero subido; sin el blob en la RAM, ninguna) */
+static void som_prepara(som_mod_t *sm, const modelo_t *mo)
+{
+    uint32_t k, n = 0, cap = 0;
+    free(sm->ml); sm->ml = NULL; sm->n = 0; sm->datos = mo->datos;
+    if (!mo->datos || !mo->blob || !mo->tv) return;
+    for (k = mo->inicio[2]; k < mo->inicio[3]; k++) {
+        const malla_t *m = mo->mallas + k; const vert_t *v = mo->verts + m->v0; float y0 = 1e9f, y1 = -1e9f, u0 = 1e9f, u1 = -1e9f, v0 = 1e9f, v1 = -1e9f;
+        uint32_t i, lum = 0, al = 0; int a, b;
+        if (m->tex < 0 || m->n < 3 || m->n > 128 || k > 0xFFFF) continue;
+        for (i = 0; i < m->n; i++) {
+            y0 = fminf(y0, v[i].y); y1 = fmaxf(y1, v[i].y);
+            u0 = fminf(u0, v[i].u); u1 = fmaxf(u1, v[i].u); v0 = fminf(v0, v[i].v); v1 = fmaxf(v1, v[i].v);
+        }
+        if (y1 - y0 > SOM_PLANO) continue;
+        for (a = 0; a < 3; a++) for (b = 0; b < 3; b++) {
+            uint32_t c = som_texel(mo, m->tex, u0 + (u1 - u0) * (0.2f + 0.3f * a), v0 + (v1 - v0) * (0.2f + 0.3f * b));
+            lum += (((c >> 16) & 255) * 3 + ((c >> 8) & 255) * 6 + (c & 255)) / 10; al += c >> 24;
+        }
+        if (lum / 9 >= SOM_LUM || al / 9 < 16) continue;
+        if (n == cap) { uint16_t *q = realloc(sm->ml, (cap = cap ? 2 * cap : 64) * sizeof(uint16_t)); if (!q) break; sm->ml = q; }
+        sm->ml[n++] = (uint16_t)k;
+    }
+    sm->n = n;
+    dbglog(DBG_INFO, "SOMBRAS: %u mallas de sombra\n", (unsigned)n);
+}
+/* lo oscuro (0..1) en el punto p del mundo: lo mas oscuro de las mallas de sombra que tiene debajo */
+static float som_en(const float *p)
+{
+    float d = 0; int t;
+    for (t = 0; t < 3; t++) {
+        const modelo_t *mo = tramos[t]; const som_mod_t *sm = som_m + t; uint32_t j;
+        if (!mo->datos || !mo->blob || sm->datos != mo->datos) continue;
+        for (j = 0; j < sm->n; j++) {
+            const malla_t *m = mo->mallas + sm->ml[j]; const vert_t *v = mo->verts + m->v0; float dx = p[0] - m->cx, dz = p[2] - m->cz; uint32_t i;
+            if (dx * dx + dz * dz > m->r * m->r || fabsf(p[1] - m->cy) > 4.0f) continue;
+            for (i = 0; i + 2 < m->n; i++) {
+                const vert_t *a = v + i, *b = v + i + 1, *c = v + i + 2;
+                float den = (b->z - c->z) * (a->x - c->x) + (c->x - b->x) * (a->z - c->z), l0, l1, l2, s, al, lu; uint32_t tx;
+                if (fabsf(den) < 1e-6f) continue;
+                l0 = ((b->z - c->z) * (p[0] - c->x) + (c->x - b->x) * (p[2] - c->z)) / den;
+                l1 = ((c->z - a->z) * (p[0] - c->x) + (a->x - c->x) * (p[2] - c->z)) / den;
+                l2 = 1 - l0 - l1;
+                if (l0 < 0 || l1 < 0 || l2 < 0) continue;
+                tx = som_texel(mo, m->tex, l0 * a->u + l1 * b->u + l2 * c->u, l0 * a->v + l1 * b->v + l2 * c->v);
+                al = (float)(tx >> 24) * (l0 * (float)(a->c >> 24) + l1 * (float)(b->c >> 24) + l2 * (float)(c->c >> 24)) * (1.0f / 65025.0f);
+                lu = (float)((((tx >> 16) & 255) * 3 + ((tx >> 8) & 255) * 6 + (tx & 255)) / 10) * (1.0f / 255.0f);
+                s = al * (1 - lu);
+                if (s > d) d = s;
+                break;
+            }
+        }
+    }
+    return d > 1 ? 1 : d;
+}
+/* cada cuadro, despues de coche_luz */
+static void coche_sombra(matrix_t mc)
+{
+    uint8_t q[SOM_N]; int k, cambia = 0, alguna = 0; uint32_t e, i;
+    if (!SOMBRA_COCHE || !ref_on) {
+        if (som_aplicada) { som_aplicada = 0; coche_color(cex_color); if (ref_on) ref_base(1); }
+        return;
+    }
+    for (k = 0; k < 3; k++) if (som_m[k].datos != tramos[k]->datos) som_prepara(som_m + k, tramos[k]);
+    if (!som_z_ok) {                                            /* lo que ocupa la carroceria a lo largo (z del modelo) */
+        som_z0 = 1e9f; som_z1 = -1e9f;
+        for (e = 0; e < cex_n; e++) if (REF_MALLA(cex_m + e)) {
+            const malla_t *m = coche.mallas + cex_m[e].malla;
+            for (i = 0; i < m->n; i++) { som_z0 = fminf(som_z0, coche.verts[m->v0 + i].z); som_z1 = fmaxf(som_z1, coche.verts[m->v0 + i].z); }
+        }
+        som_z_ok = som_z1 > som_z0;
+        if (!som_z_ok) return;
+    }
+    for (k = 0; k < SOM_N; k++) {
+        float z = som_z0 + (som_z1 - som_z0) * k / (SOM_N - 1), p[3]; int j;
+        for (j = 0; j < 3; j++) p[j] = mc[3][j] + mc[2][j] * z + mc[1][j] * 0.6f;   /* (un poco por encima del suelo) */
