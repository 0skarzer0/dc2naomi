+#ifdef GD_ZCK
+/* NAOMI (2026-11, dc2naomi): los ficheros grandes van comprimidos en el disco para que el juego quepa en los 512 MB de
+   la NetDIMM. Formato ZCK1 (tools/zck.py): "ZCK1", tamano original, tamano del trozo (65536), numero de trozos, y
+   n + 1 desplazamientos (desde el principio del fichero) de cada trozo zlib; un trozo que no gana se guarda tal cual
+   (su longitud es la del trozo). gd_busca devuelve para ellos un LBA "virtual" (bit 30, indice del fichero en los
+   bits 18-29 y el sector dentro del fichero abajo) y el tamano original, y lee() descomprime los sectores que se
+   piden: nadie mas nota nada (ni los paquetes de uniones y etapas, que leen ventanas de SEGS.PAK y UNIONES.PAK). */
+#define ZV 0x40000000u
+#define ZF_MAX 1024
+#define ZTROZO 65536u
+typedef struct { uint32_t plba, tam, n; uint32_t *off; } zf_t;
+static zf_t zf[ZF_MAX]; static int nzf;
+static uint32_t llano[2048]; static int nllano;            /* LBA de ficheros que no son ZCK1 (ya mirados) */
+#define ZC 4
+static uint8_t zc_dat[ZC][ZTROZO] __attribute__((aligned(32)));
+static uint32_t zc_tag[ZC] = { 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu }, zc_uso[ZC], zc_t;
+static uint8_t zbuf[ZTROZO + 4096] __attribute__((aligned(32)));
+/* tras busca: si el fichero es ZCK1, *lba y *tam pasan a los virtuales */
+static void z_mira(uint32_t *lba, uint32_t *tam)
+{
+    int i;
+    for (i = 0; i < nzf; i++) if (zf[i].plba == *lba) { *lba = ZV | (uint32_t)i << 18; *tam = zf[i].tam; return; }
+    for (i = 0; i < nllano; i++) if (llano[i] == *lba) return;
+    if (*tam >= 16 && nzf < ZF_MAX && !lee_f(*lba, 1, sec) && !memcmp(sec, "ZCK1", 4)) {
+        zf_t *z = &zf[nzf];
+        memcpy(&z->tam, sec + 4, 4); memcpy(&z->n, sec + 12, 4);
+        z->plba = *lba; z->off = NULL;
+        *lba = ZV | (uint32_t)nzf << 18; *tam = z->tam; nzf++;
+        return;
+    }
+    if (nllano < (int)(sizeof llano / sizeof *llano)) llano[nllano++] = *lba;
+}
+static const uint8_t *z_trozo(int f, uint32_t c, uint32_t *ul)
+{
+    zf_t *z = &zf[f]; uint32_t tag = (uint32_t)f << 16 | c, o0, o1, s0, s1; int k, v = 0;
+    uLongf dl;
+    *ul = c + 1 < z->n || !(z->tam % ZTROZO) ? ZTROZO : z->tam % ZTROZO;
+    for (k = 0; k < ZC; k++) if (zc_tag[k] == tag) { zc_uso[k] = ++zc_t; return zc_dat[k]; }
+    if (!z->off) {                                          /* la tabla de trozos, la primera vez */
+        uint32_t hb = 16 + 4 * (z->n + 1), hs = (hb + 2047) / 2048;
+        uint8_t *h = memalign(32, hs * 2048);
+        if (!h || lee_f(z->plba, hs, h)) { free(h); return NULL; }
+        z->off = (uint32_t *)(h + 16);
+    }
+    for (k = 1; k < ZC; k++) if (zc_uso[k] < zc_uso[v]) v = k;
+    o0 = z->off[c]; o1 = z->off[c + 1];
+    s0 = o0 / 2048; s1 = (o1 + 2047) / 2048;
+    if (o1 <= o0 || (s1 - s0) * 2048 > sizeof zbuf || lee_f(z->plba + s0, s1 - s0, zbuf)) return NULL;
+    if (o1 - o0 == *ul) memcpy(zc_dat[v], zbuf + o0 % 2048, *ul);
+    else { dl = *ul; if (uncompress(zc_dat[v], &dl, zbuf + o0 % 2048, o1 - o0) != Z_OK || dl != *ul) return NULL; }
+    zc_tag[v] = tag; zc_uso[v] = ++zc_t;
+    return zc_dat[v];
+}
+static int z_lee(uint32_t lba, int n, uint8_t *dst)
+{
+    int f = (lba >> 18) & 0xFFF, r = 0;
+    uint32_t p = (lba & 0x3FFFF) * 2048, fin = p + (uint32_t)n * 2048;
+    if (f >= nzf) return ERR_SYS;
+    mutex_lock(&m_gd);
+    while (p < fin) {
+        uint32_t c = p / ZTROZO, o = p % ZTROZO, ul, m;
+        const uint8_t *t;
+        if (p >= zf[f].tam) { memset(dst, 0, fin - p); break; }
+        if (!(t = z_trozo(f, c, &ul))) { r = ERR_SYS; break; }
+        m = ul - o < fin - p ? ul - o : fin - p;
+        memcpy(dst, t + o, m); dst += m; p += m;
+    }
+    mutex_unlock(&m_gd);
+    return r;
+}
+static int lee(uint32_t lba, int n, void *dst) { return (lba & ZV) ? z_lee(lba, n, dst) : lee_f(lba, n, dst); }
+#else
+static int lee(uint32_t lba, int n, void *dst) { return lee_f(lba, n, dst); }
+#endif
 int gd_lee(uint32_t lba, int n, void *dst) { return lee(lba, n, dst); }
 
 static int busca(const char *nombre, uint32_t *lba, uint32_t *tam);
@@ -105,12 +182,22 @@ static int busca(const char *nombre, uint32_t *lba, uint32_t *tam)
         else {                                              /* no cabe: sector a sector, como antes */
             for (o = 0; o < rs; o += 2048) {
                 if (lee(rl + o / 2048, 1, sec)) return -2;
-                if (entrada(sec, nombre, ln, lba, tam)) return 0;
+                if (entrada(sec, nombre, ln, lba, tam)) {
+#ifdef GD_ZCK
+                    z_mira(lba, tam);
+#endif
+                    return 0;
+                }
             }
             return -3;
         }
     }
-    for (o = 0; o < dir_tam; o += 2048) if (entrada(dir_c + o, nombre, ln, lba, tam)) return 0;
+    for (o = 0; o < dir_tam; o += 2048) if (entrada(dir_c + o, nombre, ln, lba, tam)) {
+#ifdef GD_ZCK
+        z_mira(lba, tam);
+#endif
+        return 0;
+    }
     return -3;
 }
 
