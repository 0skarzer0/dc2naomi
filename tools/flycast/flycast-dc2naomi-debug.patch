 #include "holly_intc.h"
 #include "sb.h"
 #include "hw/sh4/sh4_interrupts.h"
@@ -8,8 +10,11 @@
 */
 
 //asic_RLXXPending: Update the intc flags for pending interrupts
+// (local test) FC_EXT3: ISTEXT bit 3 stuck high, as the NetDIMM keeps it on the real board
+static bool ext3_stuck() { static int v = -1; if (v < 0) v = getenv("FC_EXT3") != nullptr; return v; }
 static void asic_RL6Pending()
 {
+	if (ext3_stuck()) SB_ISTEXT |= 8;
 	bool t1 = (SB_ISTNRM & SB_IML6NRM) != 0;
 	bool t2 = (SB_ISTERR & SB_IML6ERR) != 0;
 	bool t3 = (SB_ISTEXT & SB_IML6EXT) != 0;
@@ -20,16 +25,20 @@ static void asic_RL6Pending()
 
 static void asic_RL4Pending()
 {
+	if (ext3_stuck()) SB_ISTEXT |= 8;
 	bool t1 = (SB_ISTNRM & SB_IML4NRM) != 0;
 	bool t2 = (SB_ISTERR & SB_IML4ERR) != 0;
 	bool t3 = (SB_ISTEXT & SB_IML4EXT) != 0;
 	bool t4 = (SB_ISTNRM1 & SB_IML4NRM) != 0;
 
-	InterruptPend(sh4_IRL_11, t1 || t2 || t3 || t4);
+	// (local test) FC_NOIRL11: the level 4 ASIC interrupt (IRL 11) never reaches the SH4
+	static int noirl11 = -1; if (noirl11 < 0) noirl11 = getenv("FC_NOIRL11") != nullptr;
+	InterruptPend(sh4_IRL_11, !noirl11 && (t1 || t2 || t3 || t4));
 }
 
 static void asic_RL2Pending()
 {
+	if (ext3_stuck()) SB_ISTEXT |= 8;
 	bool t1 = (SB_ISTNRM & SB_IML2NRM) != 0;
 	bool t2 = (SB_ISTERR & SB_IML2ERR) != 0;
 	bool t3 = (SB_ISTEXT & SB_IML2EXT) != 0;
@@ -187,6 +196,7 @@ static void Write_SB_IML6EXT(u32 addr, u32 data)
 	if (Naomi2 && (addr & 0x2000000) != 0)
 		// Ignore CLXB settings
 		return;
+	if (getenv("FC_G2TRACE")) fprintf(stderr, "IML6EXT=%x (ISTEXT=%x)\n", data, SB_ISTEXT);
 	SB_IML6EXT = data;
 
 	asic_RL6Pending();
@@ -198,6 +208,7 @@ static void Write_SB_IML4EXT(u32 addr, u32 data)
 	if (Naomi2 && (addr & 0x2000000) != 0)
 		// Ignore CLXB settings
 		return;
+	if (getenv("FC_G2TRACE")) fprintf(stderr, "IML4EXT=%x (ISTEXT=%x)\n", data, SB_ISTEXT);
 	SB_IML4EXT = data;
 
 	asic_RL4Pending();
