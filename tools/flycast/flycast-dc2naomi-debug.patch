 	if (Naomi2 && (addr & 0x2000000) != 0)
 		// Ignore CLXB settings
 		return;
+	if (getenv("FC_G2TRACE")) fprintf(stderr, "IML2EXT=%x (ISTEXT=%x)\n", data, SB_ISTEXT);
